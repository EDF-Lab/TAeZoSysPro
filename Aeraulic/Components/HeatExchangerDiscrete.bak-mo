within TAeZoSysPro.Aeraulic.Components;

model HeatExchangerDiscrete
  replaceable package Medium = TAeZoSysPro.Aeraulic.Media.MyMedia;
  //
  parameter HeatTransfer.Types.ExchangerType exchangerType = HeatTransfer.Types.ExchangerType.CounterFlow;
  parameter Integer N(unit = "Z+*") = 3 "Number of split : 1 to 65535";
  //
  parameter Real ksi_fixed = 1.0 "fixed pressure loss coefficient" annotation(
    Dialog(group = "Flow"));
  //
  parameter Modelica.SIunits.Area crossArea = 1.0 "Inner cross section area" annotation(
    Dialog(group = "Geometry"));
  parameter Modelica.SIunits.Area ExchangeArea = 1.0 "Mean exchange area" annotation(
    Dialog(group = "Geometry"));
  
  //
  constant Modelica.SIunits.SpecificHeatCapacity cpLiquid = 4180 ;
  constant Modelica.SIunits.MassFlowRate m_flow_water = 1 ;
  // Internal variable
  Modelica.SIunits.Temperature Tliq_out ;
  // Internal components
  Modelica.Fluid.Interfaces.FluidPort_a portGas_in(replaceable package Medium = Medium) annotation(
    Placement(visible = true, transformation(origin = {-100, 52}, extent = {{-10, -10}, {10, 10}}, rotation = 0), iconTransformation(origin = {-100, 52}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  Modelica.Fluid.Interfaces.FluidPort_b portGas_out(replaceable package Medium = Medium) annotation(
    Placement(visible = true, transformation(origin = {100, 50}, extent = {{-10, -10}, {10, 10}}, rotation = 0), iconTransformation(origin = {100, 50}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  TAeZoSysPro.HeatTransfer.BasesClasses.Convection[N] convectionGas;
  TAeZoSysPro.HeatTransfer.BasesClasses.Convection[N] convectionLiquid;
  TAeZoSysPro.Aeraulic.BasesClasses.dropwiseCondensation[N] condensation;
  TAeZoSysPro.Aeraulic.BasesClasses.GasNode[N] gasNode;
  TAeZoSysPro.Aeraulic.Components.PressureLosses.Pipes.AdiabaticStaticPipe[N+1] AeroResistance(each crossArea=crossArea, each ksi_fixed = ksi_fixed / (N+1)) ;
  Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a portLiquid_in annotation(
    Placement(visible = true, transformation(origin = {100, -60}, extent = {{-10, -10}, {10, 10}}, rotation = 0), iconTransformation(origin = {100, -60}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_b portLiquid_out annotation(
    Placement(visible = true, transformation(origin = {-100, -60}, extent = {{-10, -10}, {10, 10}}, rotation = 0), iconTransformation(origin = {-100, -60}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));

equation
//
// Boundary connections
connect(portGas_in, AeroResistance[1].fluidport_a) ;
connect(AeroResistance[1].fluidport_b, gasNode[1].Fluidport[1]) ;
connect(gasNode[N].Fluidport[2], AeroResistance[N+1].fluidport_a) ;
connect(AeroResistance[N+1].fluidport_b, portGas_out) ;
for i in 2:N loop
  // Connection of gas nodes with aeraulic resistance
  connect(gasNode[i-1].Fluidport[2], AeroResistance[i].fluidport_a) ;
  connect(AeroResistance[i].fluidport_b, gasNode[i].Fluidport[1]) ; 
end for;

  for i in 1:N loop
      // Connection of gas nodes with convection module
      connect(gasNode[i].Heatport, convectionGas[i].Heatport_b);
      // Connection of gas nodes with condensation module
      connect(gasNode[i].Flowport, condensation[i].Flowport);
      // Connection of wallports for flux conservation
      connect(convectionGas[i].Heatport_a, convectionLiquid[i].Heatport_a);
      connect(condensation[i].Heatport, convectionLiquid[i].Heatport_a);
      
      // Connection for liquid potential
      if N == N then
        convectionLiquid[i].Heatport_b.T = portLiquid_in.T ;
      else
        m_flow * cpLiquid * (convectionLiquid[i+1].Heatport_b.T - convectionLiquid[i].Heatport_b.T) = convectionLiquid[i+1].Heatport_b.Q_flow  ; 
      end if ;         
      
    end for;
//
sum(convectionLiquid.Q_flow) = m_flow_water * cpLiquid * (portLiquid_in.T - Tliq_out) ;
// portLiquid_in acts as a temperature sensor   
portLiquid_in.Q_flow = 0.0 ;
portLiquid_out.Q_flow = m_flow_water * cpLiquid * (portLiquid_out.T - Tliq_out) ;

annotation(
    Diagram(coordinateSystem(initialScale = 0.1), graphics = {Rectangle(lineThickness = 0.5, extent = {{-100, 100}, {100, -100}}), Ellipse(origin = {-65, 70}, lineColor = {0, 85, 255}, fillColor = {255, 255, 255}, pattern = LinePattern.Dash, fillPattern = FillPattern.Sphere, lineThickness = 0.5, extent = {{-11, 12}, {13, -12}}, endAngle = 360), Rectangle(lineColor = {152, 152, 152}, fillColor = {238, 238, 238},pattern = LinePattern.Dash, fillPattern = FillPattern.HorizontalCylinder,lineThickness = 0.5, extent = {{-100, 6}, {100, -6}}), Line(origin = {-70, 28}, points = {{-20, 0}, {12, 0}}, color = {0, 85, 255}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {-70, 18}, points = {{-20, 0}, {12, 0}}, color = {0, 85, 255}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {-70, 38}, points = {{-20, 0}, {12, 0}}, color = {0, 85, 255}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {-84, 28}, points = {{0, 16}, {0, -16}}, color = {255, 0, 0}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {-66, 28}, points = {{0, 16}, {0, -16}}, color = {255, 0, 0}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Polygon(origin = {-45, 35}, lineColor = {0, 85, 255}, fillColor = {255, 255, 255}, pattern = LinePattern.None, fillPattern = FillPattern.CrossDiag, lineThickness = 0.5, points = {{-5, -19}, {7, -19}, {1, -1}, {-5, -19}}), Ellipse(origin = {-45, 17}, lineColor = {0, 85, 255}, fillColor = {255, 255, 255}, pattern = LinePattern.None, fillPattern = FillPattern.CrossDiag, lineThickness = 0.5, extent = {{-5, 5}, {7, -7}}, endAngle = 360), Line(origin = {44, 28}, points = {{0, 16}, {0, -16}}, color = {255, 0, 0}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {58, 38}, points = {{-20, 0}, {12, 0}}, color = {0, 85, 255}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {62, 28}, points = {{0, 16}, {0, -16}}, color = {255, 0, 0}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {58, 28}, points = {{-20, 0}, {12, 0}}, color = {0, 85, 255}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {58, 18}, points = {{-20, 0}, {12, 0}}, color = {0, 85, 255}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Ellipse(origin = {87, 17}, lineColor = {0, 85, 255}, fillColor = {255, 255, 255}, pattern = LinePattern.None, fillPattern = FillPattern.CrossDiag, lineThickness = 0.5, extent = {{-5, 5}, {7, -7}}, endAngle = 360), Polygon(origin = {87, 35}, lineColor = {0, 85, 255}, fillColor = {255, 255, 255}, pattern = LinePattern.None, fillPattern = FillPattern.CrossDiag, lineThickness = 0.5, points = {{-5, -19}, {7, -19}, {1, -1}, {-5, -19}}), Line(origin = {-60, -34}, rotation = 180, points = {{-20, 0}, {12, 0}}, color = {0, 85, 255}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {-60, -44}, rotation = 180, points = {{-20, 0}, {12, 0}}, color = {0, 85, 255}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {-48, -44}, points = {{0, 16}, {0, -16}}, color = {255, 0, 0}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {-60, -54}, rotation = 180, points = {{-20, 0}, {12, 0}}, color = {0, 85, 255}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {-64, -44}, points = {{0, 16}, {0, -16}}, color = {255, 0, 0}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {62, -54}, rotation = 180, points = {{-20, 0}, {12, 0}}, color = {0, 85, 255}, pattern = LinePattern.Dash, thickness = 0.5, arrow = {Arrow.None, Arrow.Open}), Line(origin = {7