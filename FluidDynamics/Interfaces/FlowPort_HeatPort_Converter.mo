within TAeZoSysPro.FluidDynamics.Interfaces;

model FlowPort_HeatPort_Converter
  replaceable package Medium = Modelica.Media.Air.MoistAir ;
  TAeZoSysPro.Aeraulic.Interfaces.FlowPort_a flowPort(redeclare package Medium = Medium) annotation(
    Placement(visible = true, transformation(origin = {-100, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0), iconTransformation(origin = {-100, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a heatPort annotation(
    Placement(visible = true, transformation(origin = {100, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0), iconTransformation(origin = {100, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));

equation

flowPort.m_flow = fill(0.0, Medium.nX) ;
flowPort.H_flow + heatPort.Q_flow = 0.0  ;
flowPort.T = heatPort.T  ;

annotation(
    Icon(graphics = {Bitmap(origin = {-1, 1}, extent = {{-79, 79}, {81, -81}}, imageSource = "")}),
    Documentation(info = "
    <html>
	<head>
		<title>FlowPort_HeatPort_Converter</title>
	</head>
	
	<style type=\"text/css\">
		*       { font-size: 10pt; font-family: Arial,sans-serif; }
		code    { font-size:  9pt; font-family: Courier,monospace;}
		h6      { font-size: 10pt; font-weight: bold; color: green; }
		h5      { font-size: 11pt; font-weight: bold; color: green; }
		h4      { font-size: 13pt; font-weight: bold; color: green; }
		address {                  font-weight: normal}
		td      { solid #000; vertical-align:top; }
		th      { solid #000; vertical-align:top; font-weight: bold; }
		table   { solid #000; border-collapse: collapse;}
		</style>
	
	<body lang=\"en-UK\">
	
		<p>
			This components allows to have a kind of link between a library using eclusively FlowPorts and the universal HeatPort from the modelica
			library because the FlowPort from the TAeZoSysPro library are not part of a standard. 
		</p>
		
		<p>
			The FlowPort encompasses the same variables, same in the sens where they represents the same quantities, than the HeatPort. But the FlowPort
			contained more potential variables than the Heatport. Therefore it is not a convecter fully bidirectionnal.
		</p>
		
		<h4> The FlowPort is connected to a model that supplies values for its potential variable and expects values for flow variable </h4>
		<p>
			In that case the temperature of the HeatPort is known from the FlowPort and the Heat Flow going though the HeatPort is given to the FlowPort.
			The mass flow rate through the FlowPort is set to 0.
		</p>
		
		<h4> The FlowPort is connected to a model that expects values for its potential variables </h4>
		<p>
			In that case there are missing equations for the potential variables that are not given from the HeatPort. That is to say the density vector.
		</p>
		
	</body>
</html>"));
    
end FlowPort_HeatPort_Converter;
